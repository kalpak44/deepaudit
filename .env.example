# Documentation only: DeepAudit does not load this file automatically.
# In CI these are repository secrets/variables; locally, export them in your shell.
DEEPSEEK_API_KEY=replace-with-your-own-key
DEEPSEEK_MODEL=deepseek-flash
# Root dispatches sub-agent roles as workflows; the default GITHUB_TOKEN cannot start a
# workflow run, so root authenticates gh with this PAT (repo + workflow scope).
GH_ADMIN_TOKEN=replace-with-a-pat
