# DeepAudit configuration. In GitHub, set the *_API_KEY / GH_ADMIN_TOKEN as repository
# secrets and the LLM_* model/URL knobs as repository variables. Locally, copy to .env.

# --- Model (OpenAI-compatible chat API; DeepSeek by default) ---
# Provide either LLM_API_KEY or DEEPSEEK_API_KEY.
LLM_API_KEY=
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-chat
LLM_MODEL_STRONG=deepseek-reasoner

# --- GitHub fan-out ---
# PAT with repo + workflow scope. The supervisor dispatches worker runs with it; the default
# GITHUB_TOKEN cannot start a dispatched run. Without it, the supervisor still runs — it just
# does all work in its own runner instead of scaling out to parallel workers.
GH_ADMIN_TOKEN=

# --- CVE intelligence (all optional) ---
# cve_lookup (OSV/KEV/EPSS), cve_search (NVD) and exploit_lookup (GitHub PoC datasets) work with
# NO key. An NVD API key only raises the rate limit (5 -> 50 requests / 30s): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Optional general web-search backend for open-web CVE/exploit research beyond NVD/Exploit-DB/GitHub.
# Backend-agnostic. Default (unset) is ddg = DuckDuckGo HTML, KEYLESS. For Brave set
# SEARCH_PROVIDER=brave and SEARCH_API_KEY=<brave subscription token>. Tavily: SEARCH_PROVIDER=tavily.
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# --- Local run only ---
TARGET=https://example.com
